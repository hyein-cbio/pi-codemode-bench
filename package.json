{
  "name": "pi-codemode-bench",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "type": "module",
  "description": "Implementation-neutral, correctness-gated benchmarks for configurable codemode-compatible tools and runtimes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyein-cbio/pi-codemode-bench.git"
  },
  "homepage": "https://github.com/hyein-cbio/pi-codemode-bench#readme",
  "bugs": {
    "url": "https://github.com/hyein-cbio/pi-codemode-bench/issues"
  },
  "keywords": [
    "benchmark",
    "codemode",
    "latency",
    "correctness",
    "tool-calling"
  ],
  "bin": {
    "codemode-bench": "./bench.mjs"
  },
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bench.mjs",
    "index.mjs",
    "index.d.ts",
    "cases.mjs",
    "tasks.mjs",
    "bench.config.example.json",
    "lib/",
    "adapters/",
    "corpus/",
    "examples/",
    "scripts/",
    "docs/",
    "benchmarks/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bench": "node bench.mjs",
    "bench:smoke": "node bench.mjs --warmup=1 --samples=1 --sets=smoke,short",
    "bench:all": "node bench.mjs --sets=all",
    "bench:json": "node bench.mjs --sets=json-scale",
    "bench:stress": "node bench.mjs --sets=stress",
    "bench:list": "node bench.mjs --sets=all --list",
    "bench:demo": "node bench.mjs --config=bench.config.example.json --sets=smoke,short --warmup=1 --samples=1",
    "bench:example": "node bench.mjs --config=examples/targets/pi-comparison.json --sets=all --warmup=4 --samples=20 --seed=1",
    "check:language": "node scripts/check-language.mjs",
    "tasks": "node tasks.mjs --list",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:pack": "node scripts/test-pack.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "test:targets": "node --test test/targets.test.mjs",
    "test:core": "node --test test/corpus.test.mjs test/fixtures.test.mjs test/generic-tool.test.mjs"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@opencode/codemode": "2.1.0",
    "effect": "4.0.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@opencode/codemode": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@opencode/codemode": "2.1.0",
    "effect": "4.0.1"
  }
}
